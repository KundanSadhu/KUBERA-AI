{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KUBERA AI",
  "version": "0.1.0",
  "identifier": "ai.kubera.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run check",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KUBERA AI",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:4096 http://localhost:4096; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/opencode-cli",
      "binaries/officecli"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
